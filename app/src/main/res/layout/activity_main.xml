<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Halo, Selamat Datang!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnNotification"
            android:layout_marginEnd="16dp" />

        <ImageButton
            android:id="@+id/btnNotification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bell"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:layout_marginEnd="16dp"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="@id/tvWelcome"
            app:layout_constraintBottom_toBottomOf="@id/tvWelcome"
            app:layout_constraintEnd_toStartOf="@+id/btnCart" />

        <ImageButton
            android:id="@+id/btnCart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_cart"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:layout_marginEnd="16dp"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="@id/tvWelcome"
            app:layout_constraintBottom_toBottomOf="@id/tvWelcome"
            app:layout_constraintEnd_toStartOf="@+id/btnProfile" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_person_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="@id/tvWelcome"
            app:layout_constraintBottom_toBottomOf="@id/tvWelcome"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSelectCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Kategori Menu:"
            android:textColor="#FFFFFF"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/llCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvSelectCategory">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKategoriMartabak"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Martabak"
                app:cornerRadius="16dp"
                android:backgroundTint="#F57C00"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKategoriTerangBulan"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Terang Bulan"
                app:cornerRadius="16dp"
                android:backgroundTint="#F57C00"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- FITUR GRAFIK -->
        <TextView
            android:id="@+id/tvRekomendasiTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Statistik Menu Terlaris 🔥"
            android:layout_marginTop="32dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/llCategories"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvGrafik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#2C2C2C"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvRekomendasiTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ketuk bar grafik untuk memesan langsung"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="16dp"/>

                <!-- BATANG GRAFIK 1 -->
                <LinearLayout
                    android:id="@+id/btnRek1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Martabak Telur Spesial + Keju" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginBottom="6dp" />
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:background="#444444" android:weightSum="100">
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="90" android:background="#E53935"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="185 Terjual" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginStart="12dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- BATANG GRAFIK 2 -->
                <LinearLayout
                    android:id="@+id/btnRek2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Red Velvet Keju Susu" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:background="#444444" android:weightSum="100">
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="75" android:background="#F57C00"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="150 Terjual" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginStart="12dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- BATANG GRAFIK 3 -->
                <LinearLayout
                    android:id="@+id/btnRek3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3. Pandan Coklat Kacang Susu" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:background="#444444" android:weightSum="100">
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="55" android:background="#388E3C"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="110 Terjual" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginStart="12dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TOMBOL MENUJU LAPORAN KEUANGAN DIPERBAIKI (MENGGUNAKAN BUTTON STANDAR) -->
        <Button
            android:id="@+id/btnLaporan"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:text="Lihat Laporan Keuangan"
            android:backgroundTint="#4E342E"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/cvGrafik"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>