<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- TOMBOL BACK -->
    <ImageButton
        android:id="@+id/btnBackInfo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_back_arrow"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- JUDUL HALAMAN -->
    <TextView
        android:id="@+id/tvInfoLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Detail Menu"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/btnBackInfo"
        app:layout_constraintBottom_toBottomOf="@id/btnBackInfo"
        app:layout_constraintStart_toEndOf="@id/btnBackInfo"
        app:layout_constraintEnd_toStartOf="@+id/btnCartInfo" />

    <!-- IKON KERANJANG BARU DI POJOK KANAN ATAS (DIUBAH UKURANNYA) -->
    <ImageButton
        android:id="@+id/btnCartInfo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_cart"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="@id/btnBackInfo"
        app:layout_constraintBottom_toBottomOf="@id/btnBackInfo"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivInfoGambar"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="32dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@id/btnBackInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvInfoNamaMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nama Menu"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/ivInfoGambar" />

    <TextView
        android:id="@+id/tvInfoHargaMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rp 00.000"
        android:textSize="18sp"
        android:textColor="#388E3C"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvInfoNamaMenu" />

    <TextView
        android:id="@+id/tvInfoDeskripsi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deskripsi tentang bahan dan rasa akan muncul di sini."
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvInfoHargaMenu" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvInfoDeskripsi"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnBeliLangsung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Beli Langsung Sekarang"
            android:backgroundTint="#388E3C"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnTambahKeranjang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah ke Keranjang"
            android:backgroundTint="@color/orange_primary"
            android:textColor="@color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>